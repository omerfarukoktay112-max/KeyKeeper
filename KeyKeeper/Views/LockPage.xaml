<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KeyKeeper.Localization"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.LockPage"
             x:DataType="viewmodels:LockViewModel"
             Title="{x:Static loc:S.VaultLocked}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label
                Text="{x:Static loc:S.VaultLocked}"
                Style="{StaticResource Headline}"
                HorizontalTextAlignment="Center" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="{x:Static loc:S.MasterPasswordPlaceholder}"
                Text="{Binding Password}"
                IsPassword="True"
                IsEnabled="{Binding AreInputsEnabled}"
                ReturnCommand="{Binding UnlockCommand}" />

            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding HasError}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="{Binding LockoutRemainingText, StringFormat={x:Static loc:S.RemainingTime}}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding IsLockedOut}"
                HorizontalTextAlignment="Center"
                FontAttributes="Bold" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button
                Text="{x:Static loc:S.Unlock}"
                Command="{Binding UnlockCommand}"
                HorizontalOptions="Fill" />

            <Button
                Text="{x:Static loc:S.UnlockBiometric}"
                Command="{Binding UnlockWithBiometricsCommand}"
                IsVisible="{Binding IsBiometricAvailable}"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
