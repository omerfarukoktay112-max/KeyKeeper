<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.LockPage"
             x:DataType="viewmodels:LockViewModel"
             Title="Kasa Kilitli">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label
                Text="Kasa Kilitli"
                Style="{StaticResource Headline}"
                HorizontalTextAlignment="Center" />

            <Entry
                Placeholder="Ana şifre"
                Text="{Binding Password}"
                IsPassword="True"
                IsEnabled="{Binding AreInputsEnabled}"
                ReturnCommand="{Binding UnlockCommand}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                IsVisible="{Binding HasError}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="{Binding LockoutRemainingText, StringFormat='Kalan süre: {0}'}"
                TextColor="Red"
                IsVisible="{Binding IsLockedOut}"
                HorizontalTextAlignment="Center"
                FontAttributes="Bold" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button
                Text="Kilidi Aç"
                Command="{Binding UnlockCommand}"
                HorizontalOptions="Fill" />

            <Button
                Text="Biyometrik ile Aç"
                Command="{Binding UnlockWithBiometricsCommand}"
                IsVisible="{Binding IsBiometricAvailable}"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
