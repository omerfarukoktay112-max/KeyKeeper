<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.LoginFormPage"
             x:DataType="viewmodels:LoginFormViewModel"
             Title="Giriş Bilgisi">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Entry Placeholder="Başlık" Text="{Binding Title}" />
            <Entry Placeholder="Kullanıcı adı" Text="{Binding Username}" />

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Şifre" Text="{Binding Password}" IsPassword="{Binding IsPasswordMasked}" />
                <Button Grid.Column="1" Text="Göster" Command="{Binding TogglePasswordVisibilityCommand}" />
                <Button Grid.Column="2" Text="Üret" Command="{Binding GeneratePasswordCommand}" />
                <Button Grid.Column="3" Text="Kopyala" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding Password}" />
            </Grid>

            <ProgressBar Progress="{Binding PasswordStrengthFraction}" ProgressColor="{Binding PasswordStrengthColor}" IsVisible="{Binding HasPasswordStrength}" />
            <Label Text="{Binding PasswordStrengthLabel}" TextColor="{Binding PasswordStrengthColor}" FontAttributes="Bold" IsVisible="{Binding HasPasswordStrength}" />
            <Label Text="{Binding ClipboardStatus}" IsVisible="{Binding HasClipboardStatus}" Style="{StaticResource StatusCaption}" />

            <Entry Placeholder="URL" Text="{Binding Url}" Keyboard="Url" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="TOTP anahtarı (opsiyonel)" Text="{Binding TotpSecret}" IsPassword="{Binding IsTotpSecretMasked}" />
                <Button Grid.Column="1" Text="Göster" Command="{Binding ToggleTotpSecretVisibilityCommand}" />
            </Grid>

            <Label Text="{Binding TotpError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasTotpError}" />

            <Border Style="{StaticResource ResultCard}" IsVisible="{Binding HasTotpCode}">
                <HorizontalStackLayout Spacing="14">
                    <Label Text="{Binding TotpDisplayCode}" FontFamily="Courier" FontSize="28" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Text="{Binding TotpRemainingSeconds, StringFormat='{0}sn'}" VerticalOptions="Center" Style="{StaticResource SubHeadline}" />
                </HorizontalStackLayout>
            </Border>

            <Picker Title="Klasör" ItemsSource="{Binding FolderOptions}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedFolderOption}" />

            <Label Text="Etiketler" FontAttributes="Bold" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Tags}" Wrap="Wrap" Direction="Row" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource TagChipBorder}">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding .}" VerticalOptions="Center" SemanticProperties.Description="{Binding ., StringFormat='Etiket: {0}'}" />
                                <Label Text="✕" VerticalOptions="Center" Style="{StaticResource TagRemoveLabel}" SemanticProperties.Description="{Binding ., StringFormat='Etiketi kaldır: {0}'}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.RemoveTagCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Yeni etiket" Text="{Binding NewTagText}" />
                <Button Grid.Column="1" Text="Ekle" Command="{Binding AddTagCommand}" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Kaydet" Command="{Binding SaveCommand}" HorizontalOptions="Fill" />
            <Button Text="Sil" Clicked="OnDeleteClicked" IsVisible="{Binding IsEditMode}" Style="{StaticResource DangerButton}" HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
