<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KeyKeeper.Localization"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.LoginFormPage"
             x:DataType="viewmodels:LoginFormViewModel"
             Title="{x:Static loc:S.LoginTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Entry Placeholder="{x:Static loc:S.FieldTitle}" Text="{Binding Title}" />
            <Entry Placeholder="{x:Static loc:S.Username}" Text="{Binding Username}" />

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="{x:Static loc:S.Password}" Text="{Binding Password}" IsPassword="{Binding IsPasswordMasked}" />
                <Button Grid.Column="1" Text="{x:Static loc:S.Show}" Command="{Binding TogglePasswordVisibilityCommand}" />
                <Button Grid.Column="2" Text="{x:Static loc:S.Generate}" Command="{Binding GeneratePasswordCommand}" />
                <Button Grid.Column="3" Text="{x:Static loc:S.Copy}" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding Password}" />
            </Grid>

            <ProgressBar Progress="{Binding PasswordStrengthFraction}" ProgressColor="{Binding PasswordStrengthColor}" IsVisible="{Binding HasPasswordStrength}" />
            <Label Text="{Binding PasswordStrengthLabel}" TextColor="{Binding PasswordStrengthColor}" FontAttributes="Bold" IsVisible="{Binding HasPasswordStrength}" />
            <Label Text="{Binding ClipboardStatus}" IsVisible="{Binding HasClipboardStatus}" Style="{StaticResource StatusCaption}" />

            <Entry Placeholder="URL" Text="{Binding Url}" Keyboard="Url" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="{x:Static loc:S.TotpSecret}" Text="{Binding TotpSecret}" IsPassword="{Binding IsTotpSecretMasked}" />
                <Button Grid.Column="1" Text="{x:Static loc:S.Show}" Command="{Binding ToggleTotpSecretVisibilityCommand}" />
            </Grid>

            <Label Text="{Binding TotpError}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasTotpError}" />

            <Border Style="{StaticResource ResultCard}" IsVisible="{Binding HasTotpCode}">
                <HorizontalStackLayout Spacing="14">
                    <Label Text="{Binding TotpDisplayCode}" FontFamily="Courier" FontSize="28" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Text="{Binding TotpRemainingSeconds, StringFormat={x:Static loc:S.SecondsShort}}" VerticalOptions="Center" Style="{StaticResource SubHeadline}" />
                </HorizontalStackLayout>
            </Border>

            <Picker Title="{x:Static loc:S.Folder}" ItemsSource="{Binding FolderOptions}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedFolderOption}" />

            <Label Text="{x:Static loc:S.Tags}" FontAttributes="Bold" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Tags}" Wrap="Wrap" Direction="Row" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource TagChipBorder}">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding .}" VerticalOptions="Center" SemanticProperties.Description="{Binding ., StringFormat={x:Static loc:S.TagDescription}}" />
                                <Label Text="✕" VerticalOptions="Center" Style="{StaticResource TagRemoveLabel}" SemanticProperties.Description="{Binding ., StringFormat={x:Static loc:S.RemoveTagDescription}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.RemoveTagCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="{x:Static loc:S.NewTag}" Text="{Binding NewTagText}" />
                <Button Grid.Column="1" Text="{x:Static loc:S.Add}" Command="{Binding AddTagCommand}" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="{x:Static loc:S.Save}" Command="{Binding SaveCommand}" HorizontalOptions="Fill" />
            <Button Text="{x:Static loc:S.Delete}" Clicked="OnDeleteClicked" IsVisible="{Binding IsEditMode}" Style="{StaticResource DangerButton}" HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
