<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.SetupPage"
             x:DataType="viewmodels:SetupViewModel"
             Title="Kasa Kurulumu">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label
                Text="KeyKeeper'a Hoş Geldiniz"
                Style="{StaticResource Headline}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Kasanızı korumak için bir ana şifre belirleyin. Bu şifre hiçbir yerde saklanmaz — unutursanız kasadaki veriler kurtarılamaz."
                Style="{StaticResource SubHeadline}"
                HorizontalTextAlignment="Center" />

            <Entry
                Placeholder="Ana şifre"
                Text="{Binding Password}"
                IsPassword="True"
                IsEnabled="{Binding AreInputsEnabled}" />

            <Entry
                Placeholder="Ana şifre (tekrar)"
                Text="{Binding ConfirmPassword}"
                IsPassword="True"
                IsEnabled="{Binding AreInputsEnabled}"
                ReturnCommand="{Binding SubmitCommand}" />

            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding HasError}"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button
                Text="Kasayı Oluştur"
                Command="{Binding SubmitCommand}"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
