<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KeyKeeper.Localization"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.SetupPage"
             x:DataType="viewmodels:SetupViewModel"
             Title="{x:Static loc:S.SetupTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label
                Text="{x:Static loc:S.Welcome}"
                Style="{StaticResource Headline}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="{x:Static loc:S.SetupIntro}"
                Style="{StaticResource SubHeadline}"
                HorizontalTextAlignment="Center" />

            <Entry
                Placeholder="{x:Static loc:S.MasterPasswordPlaceholder}"
                Text="{Binding Password}"
                IsPassword="True"
                IsEnabled="{Binding AreInputsEnabled}" />

            <Entry
                Placeholder="{x:Static loc:S.ConfirmMasterPassword}"
                Text="{Binding ConfirmPassword}"
                IsPassword="True"
                IsEnabled="{Binding AreInputsEnabled}"
                ReturnCommand="{Binding SubmitCommand}" />

            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding HasError}"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button
                Text="{x:Static loc:S.CreateVault}"
                Command="{Binding SubmitCommand}"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
