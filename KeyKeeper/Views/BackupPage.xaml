<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KeyKeeper.Localization"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.BackupPage"
             x:DataType="viewmodels:BackupViewModel"
             Title="{x:Static loc:S.BackupTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{x:Static loc:S.MasterPasswordLabel}" FontAttributes="Bold" />
            <Entry Placeholder="{x:Static loc:S.BackupPasswordPlaceholder}"
                   Text="{Binding MasterPassword}"
                   IsPassword="True"
                   IsEnabled="{Binding AreActionsEnabled}" />

            <BoxView HeightRequest="1" Margin="0,4" />

            <Label Text="{x:Static loc:S.CreateBackup}" FontAttributes="Bold" />
            <Label Text="{x:Static loc:S.CreateBackupDesc}" Style="{StaticResource StatusCaption}" HorizontalTextAlignment="Start" />
            <Button Text="{x:Static loc:S.CreateBackup}" Command="{Binding ExportVaultCommand}" IsEnabled="{Binding AreActionsEnabled}" HorizontalOptions="Fill" />

            <BoxView HeightRequest="1" Margin="0,4" />

            <Label Text="{x:Static loc:S.RestoreBackup}" FontAttributes="Bold" />
            <Label Text="{x:Static loc:S.RestoreBackupDesc}" Style="{StaticResource StatusCaption}" HorizontalTextAlignment="Start" />
            <Button Text="{x:Static loc:S.RestoreBackup}" Command="{Binding ImportVaultCommand}" IsEnabled="{Binding AreActionsEnabled}" HorizontalOptions="Fill" />

            <BoxView HeightRequest="1" Margin="0,4" />

            <Label Text="{x:Static loc:S.ExportCsv}" FontAttributes="Bold" Style="{StaticResource ErrorLabel}" />
            <Label Text="{x:Static loc:S.ExportCsvDesc}" Style="{StaticResource StatusCaption}" HorizontalTextAlignment="Start" />
            <Button Text="{x:Static loc:S.ExportCsvWarning}" Command="{Binding ExportCsvCommand}" IsEnabled="{Binding AreActionsEnabled}" Style="{StaticResource DangerButton}" HorizontalOptions="Fill" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" Style="{StaticResource StatusCaption}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
