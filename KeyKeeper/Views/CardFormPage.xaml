<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.CardFormPage"
             x:DataType="viewmodels:CardFormViewModel"
             Title="Kart">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Entry Placeholder="Başlık" Text="{Binding Title}" />
            <Entry Placeholder="Kart üzerindeki isim" Text="{Binding CardholderName}" />

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Kart numarası" Text="{Binding CardNumber}" IsPassword="{Binding IsCardNumberMasked}" Keyboard="Numeric" />
                <Button Grid.Column="1" Text="Göster" Command="{Binding ToggleCardNumberVisibilityCommand}" />
                <Button Grid.Column="2" Text="Kopyala" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding CardNumber}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Ay (AA)" Text="{Binding ExpiryMonthText}" Keyboard="Numeric" MaxLength="2" />
                <Entry Grid.Column="1" Placeholder="Yıl (YYYY)" Text="{Binding ExpiryYearText}" Keyboard="Numeric" MaxLength="4" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="CVV" Text="{Binding Cvv}" IsPassword="{Binding IsCvvMasked}" Keyboard="Numeric" MaxLength="4" />
                <Button Grid.Column="1" Text="Göster" Command="{Binding ToggleCvvVisibilityCommand}" />
                <Button Grid.Column="2" Text="Kopyala" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding Cvv}" />
            </Grid>

            <Label Text="{Binding ClipboardStatus}" IsVisible="{Binding HasClipboardStatus}" Style="{StaticResource StatusCaption}" />

            <Picker
                Title="Kart türü"
                ItemsSource="{x:Static viewmodels:CardFormViewModel.CardTypeOptions}"
                SelectedIndex="{Binding CardTypeIndex}" />

            <Picker Title="Klasör" ItemsSource="{Binding FolderOptions}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedFolderOption}" />

            <Label Text="Etiketler" FontAttributes="Bold" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Tags}" Wrap="Wrap" Direction="Row" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Style="{StaticResource TagChipBorder}">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding .}" VerticalOptions="Center" SemanticProperties.Description="{Binding ., StringFormat='Etiket: {0}'}" />
                                <Label Text="✕" VerticalOptions="Center" Style="{StaticResource TagRemoveLabel}" SemanticProperties.Description="{Binding ., StringFormat='Etiketi kaldır: {0}'}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.RemoveTagCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Yeni etiket" Text="{Binding NewTagText}" />
                <Button Grid.Column="1" Text="Ekle" Command="{Binding AddTagCommand}" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Kaydet" Command="{Binding SaveCommand}" HorizontalOptions="Fill" />
            <Button Text="Sil" Clicked="OnDeleteClicked" IsVisible="{Binding IsEditMode}" Style="{StaticResource DangerButton}" HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
