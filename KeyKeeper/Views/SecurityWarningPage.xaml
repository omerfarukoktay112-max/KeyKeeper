<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KeyKeeper.Localization"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.SecurityWarningPage"
             x:DataType="viewmodels:SecurityWarningViewModel"
             Title="{x:Static loc:S.SecurityWarningTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label
                Text="⚠️"
                FontSize="48"
                HorizontalTextAlignment="Center"
                SemanticProperties.Description="{x:Static loc:S.Warning}" />

            <Label
                Text="{x:Static loc:S.SecurityWarningTitle}"
                Style="{StaticResource Headline}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="{Binding Message}"
                HorizontalTextAlignment="Center" />

            <Button
                Text="{x:Static loc:S.ContinueAnyway}"
                Command="{Binding ContinueCommand}"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
