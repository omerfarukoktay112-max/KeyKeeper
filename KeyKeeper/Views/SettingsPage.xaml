<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KeyKeeper.Localization"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{x:Static loc:S.SettingsTitle}">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="{x:Static loc:S.Autofill}" Style="{StaticResource SubHeadline}" />
        <Label Text="{x:Static loc:S.AutofillDesc}" />

        <Label Text="{Binding AutofillStatusMessage}" Style="{StaticResource StatusCaption}" />

        <Button
            Text="{x:Static loc:S.OpenAutofillSettings}"
            Command="{Binding OpenAutofillSettingsCommand}"
            HorizontalOptions="Fill" />

    </VerticalStackLayout>

</ContentPage>
