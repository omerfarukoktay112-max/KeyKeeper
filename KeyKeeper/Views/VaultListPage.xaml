<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.VaultListPage"
             x:DataType="viewmodels:VaultListViewModel"
             Title="Kasa">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Ekle" Command="{Binding AddCommand}" />
        <ToolbarItem Text="Klasörler" Command="{Binding ManageFoldersCommand}" />
        <ToolbarItem Text="Şifre Üret" Command="{Binding OpenPasswordGeneratorCommand}" />
        <ToolbarItem Text="Yedekleme" Command="{Binding OpenBackupCommand}" />
        <ToolbarItem Text="Kilitle" Command="{Binding LockCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="0">

        <VerticalStackLayout Grid.Row="0" Padding="20,12" Spacing="8">

            <SearchBar Placeholder="Ara (isim, kullanıcı adı, URL...)" Text="{Binding SearchText}" />

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding FolderFilterOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:FolderFilterOptionViewModel">
                            <Border Style="{StaticResource FilterChipBorder}"
                                    SemanticProperties.Description="{Binding DisplayName, StringFormat='Klasör filtresi: {0}'}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectFolderFilterCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding DisplayName}" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <FlexLayout
                BindableLayout.ItemsSource="{Binding TagChips}"
                Wrap="Wrap" Direction="Row" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TagChipViewModel">
                        <Border Style="{StaticResource TagChipBorder}"
                                SemanticProperties.Description="{Binding Name, StringFormat='Etiket filtresi: {0}'}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.ToggleTagFilterCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}" VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding FavoritesOnly}" />
                <Label Text="Yalnızca favoriler" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Text="Biyometrik Kilidi Etkinleştir"
                Command="{Binding EnableBiometricUnlockCommand}"
                IsVisible="{Binding IsBiometricAvailable}"
                HorizontalOptions="Fill" />
            <Label
                Text="{Binding BiometricStatusMessage}"
                IsVisible="{Binding HasBiometricStatusMessage}"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsEmpty}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Padding="30"
            Spacing="16">
            <Label
                Text="{Binding EmptyStateMessage}"
                Style="{StaticResource SubHeadline}"
                HorizontalTextAlignment="Center" />
            <Button
                Text="İlk Öğeni Ekle"
                Command="{Binding AddCommand}"
                IsVisible="{Binding ShowAddFirstItemButton}"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            IsVisible="{Binding HasItems}"
            x:DataType="viewmodels:VaultListViewModel">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:VaultItemListEntry">
                    <Grid Padding="16,12" ColumnDefinitions="48,*,44" ColumnSpacing="14"
                          SemanticProperties.Description="{Binding Title, StringFormat='{0} öğesini aç'}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.OpenCommand, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Border
                            Grid.Column="0"
                            HeightRequest="44"
                            WidthRequest="44"
                            StrokeShape="RoundRectangle 22"
                            Stroke="Transparent"
                            BackgroundColor="{Binding Color}">
                            <Label
                                Text="{Binding Icon}"
                                FontSize="20"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource StatusCaption}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            FontSize="22"
                            HeightRequest="44"
                            WidthRequest="44"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Text" Value="⭐" />
                                    <Setter Property="SemanticProperties.Description" Value="Favorilerden çıkar" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFavorite}" Value="False">
                                    <Setter Property="Text" Value="☆" />
                                    <Setter Property="SemanticProperties.Description" Value="Favorilere ekle" />
                                </DataTrigger>
                            </Label.Triggers>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
                                    CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
