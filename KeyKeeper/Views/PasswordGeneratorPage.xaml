<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.PasswordGeneratorPage"
             x:DataType="viewmodels:PasswordGeneratorViewModel"
             Title="Şifre Üretici">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border Style="{StaticResource ResultCard}" IsVisible="{Binding HasPassword}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding GeneratedPassword}" FontFamily="Courier" FontSize="20" LineBreakMode="CharacterWrap" />

                    <ProgressBar Progress="{Binding PasswordStrengthFraction}" ProgressColor="{Binding PasswordStrengthColor}" IsVisible="{Binding HasPasswordStrength}" />
                    <Label Text="{Binding PasswordStrengthLabel}" TextColor="{Binding PasswordStrengthColor}" FontAttributes="Bold" IsVisible="{Binding HasPasswordStrength}" />

                    <Button Text="Kopyala" Command="{Binding CopyCommand}" HorizontalOptions="Fill" />
                    <Label Text="{Binding ClipboardStatus}" IsVisible="{Binding HasClipboardStatus}" Style="{StaticResource StatusCaption}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />

            <Label Text="Uzunluk" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Slider Minimum="8" Maximum="64" Value="{Binding Length}" WidthRequest="240" />
                <Label Text="{Binding Length}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding IncludeUppercase}" />
                <Label Text="Büyük harf (A-Z)" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding IncludeLowercase}" />
                <Label Text="Küçük harf (a-z)" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding IncludeDigits}" />
                <Label Text="Rakam (0-9)" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding IncludeSpecialCharacters}" />
                <Label Text="Özel karakter (!@#$...)" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding ExcludeAmbiguousCharacters}" />
                <Label Text="Belirsiz karakterleri hariç tut (0/O, 1/l/I...)" VerticalOptions="Center" LineBreakMode="WordWrap" />
            </HorizontalStackLayout>

            <Button Text="Şifre Üret" Command="{Binding GenerateCommand}" HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
