<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.LicenseFormPage"
             x:DataType="viewmodels:LicenseFormViewModel"
             Title="Lisans">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Entry Placeholder="Başlık" Text="{Binding Title}" />
            <Entry Placeholder="Yazılım/kurum adı" Text="{Binding SoftwareName}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Lisans anahtarı" Text="{Binding LicenseKey}" IsPassword="{Binding IsLicenseKeyMasked}" />
                <Button Grid.Column="1" Text="Göster" Command="{Binding ToggleLicenseKeyVisibilityCommand}" />
            </Grid>

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding HasExpiry}" />
                <Label Text="Son geçerlilik tarihi var" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <DatePicker Date="{Binding ExpiryDate}" IsVisible="{Binding HasExpiry}" />

            <Picker Title="Klasör" ItemsSource="{Binding FolderOptions}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedFolderOption}" />

            <Label Text="Etiketler" FontAttributes="Bold" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Tags}" Wrap="Wrap" Direction="Row" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="10,4" Margin="0,0,6,6" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource Gray200}">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding .}" VerticalOptions="Center" />
                                <Label Text="✕" VerticalOptions="Center" TextColor="Red">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.RemoveTagCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Yeni etiket" Text="{Binding NewTagText}" />
                <Button Grid.Column="1" Text="Ekle" Command="{Binding AddTagCommand}" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Kaydet" Command="{Binding SaveCommand}" HorizontalOptions="Fill" />
            <Button Text="Sil" Clicked="OnDeleteClicked" IsVisible="{Binding IsEditMode}" BackgroundColor="Red" HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
