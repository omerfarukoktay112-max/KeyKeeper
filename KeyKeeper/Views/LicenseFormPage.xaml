<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KeyKeeper.ViewModels"
             x:Class="KeyKeeper.Views.LicenseFormPage"
             x:DataType="viewmodels:LicenseFormViewModel"
             Title="Lisans">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Entry Placeholder="Başlık" Text="{Binding Title}" />
            <Entry Placeholder="Yazılım/kurum adı" Text="{Binding SoftwareName}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Lisans anahtarı" Text="{Binding LicenseKey}" IsPassword="{Binding IsLicenseKeyMasked}" />
                <Button Grid.Column="1" Text="Göster" Command="{Binding ToggleLicenseKeyVisibilityCommand}" />
            </Grid>

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding HasExpiry}" />
                <Label Text="Son geçerlilik tarihi var" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <DatePicker Date="{Binding ExpiryDate}" IsVisible="{Binding HasExpiry}" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Button Text="Kaydet" Command="{Binding SaveCommand}" HorizontalOptions="Fill" />
            <Button Text="Sil" Clicked="OnDeleteClicked" IsVisible="{Binding IsEditMode}" BackgroundColor="Red" HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
